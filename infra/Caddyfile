# VPS-1 Caddy (FR-021, SD §7.2, §8, research R12). OWNER REVIEW REQUIRED for the admin site.
#
# Caddy runs with network_mode: host and reads this file from the mounted /srv/madar/infra
# directory. {$VAR} values come from /srv/madar/.env: VPS1_IP, ACME_EMAIL, FIREBASE_PROJECT_ID.
# The public sites get Let's Encrypt certificates; the admin site exists only on wg0.

{
	email {$ACME_EMAIL}
	# The internal CA (admin site) is trusted by the peers' devices, not by this container.
	skip_install_trust
	# The firewall opens 443/tcp only, so don't advertise HTTP/3 (UDP).
	servers {
		protocols h1 h2
	}
}

# The security headers are set right away, so error responses (404, 502) carry them too. Removing
# Server stays in its own directive: a header block that deletes a field is deferred, and deferred
# headers are skipped on error responses.
(public_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	header -Server
}

# Public API → api-public.
api.{$VPS1_IP}.sslip.io {
	import public_headers
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000
}

# Media: content-addressed files, so they never change (SD §6.9). Flutter web fetches the bytes
# (CanvasKit decodes them), so the PWA's origins need CORS, preview channels included; a channel
# URL is `<project>--<channel>-<hash>.web.app`. Constitution V allows only those origins, so any
# other Origin gets no CORS header (the native apps send none and need none), and `Vary: Origin`
# keeps a shared cache from answering one origin with another's header.
media.{$VPS1_IP}.sslip.io {
	import public_headers
	root * /srv/media
	header Cache-Control "public, max-age=31536000, immutable"

	header Vary Origin
	@pwa_origin {
		method GET HEAD
		header_regexp Origin ^https://{$FIREBASE_PROJECT_ID}(--[a-z0-9-]+)?\.(web\.app|firebaseapp\.com)$
	}
	header @pwa_origin Access-Control-Allow-Origin "{http.request.header.Origin}"

	file_server
}

# PWA file mirror (SD §5.2, research R8). A release lives in `/r/<hash>/`, so every file in it is
# immutable; the shell revalidates. The files arrive precompressed from the release job, so Caddy
# serves `main.dart.js.br`/`.gz` instead of compressing multi-megabyte wasm per request on 1 OCPU.
# Only the two PWA origins may read it cross-origin, and only with GET (SD §8).
app.{$VPS1_IP}.sslip.io {
	import public_headers
	root * /srv/app-mirror

	@hashed path_regexp \.[0-9a-f]{8,}\.[A-Za-z0-9]+$
	# A release folder is content-addressed as a whole, so its files never change either. The
	# `not path /r/*` keeps this rule from overriding the release one below.
	@unhashed {
		not path_regexp \.[0-9a-f]{8,}\.[A-Za-z0-9]+$
		not path /r/*
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @unhashed Cache-Control "no-cache"

	# The release job writes this with the current hash; Kuma polls it (contracts/web-release.md).
	@release_check path /release-check.txt
	header @release_check Cache-Control "no-cache"

	@release path /r/*
	header @release Cache-Control "public, max-age=31536000, immutable"

	header Vary Origin
	# Repeated header lines are OR-ed: either origin matches.
	@pwa_origin {
		method GET HEAD
		header Origin https://{$FIREBASE_PROJECT_ID}.web.app
		header Origin https://{$FIREBASE_PROJECT_ID}.firebaseapp.com
	}
	header @pwa_origin Access-Control-Allow-Origin "{http.request.header.Origin}"

	file_server {
		precompressed br gzip
	}
}

# Admin, reachable only over WireGuard: Caddy listens on the wg0 address alone, with its own CA.
# /admin/api goes to api-admin (bound to 10.8.0.1:8001); the rest is the admin SPA, which is a
# symlink to the release CI deployed (research R10).
https://10.8.0.1 {
	bind 10.8.0.1
	tls internal
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Crests, logos, photos and commentator audio come from the media host (SD §8, A-R1-8); nothing
		# else may load from another origin.
		Content-Security-Policy "default-src 'self'; img-src 'self' https://media.{$VPS1_IP}.sslip.io; media-src 'self' https://media.{$VPS1_IP}.sslip.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	# Separate, as in public_headers: a deletion would defer the whole block past error responses.
	header -Server

	# No `encode` here: Caddy appends `-zstd`/`-gzip` to a strong ETag it compresses, and strips that
	# suffix again only from If-None-Match. The editor's If-Match would then never equal the version
	# api-admin computes, and every save would answer 409 edit_conflict.
	handle /admin/api/* {
		reverse_proxy 10.8.0.1:8001
	}
	handle {
		encode zstd gzip
		# `/srv/admin` is the mount; `current` is the relative symlink the deploy swaps atomically.
		root * /srv/admin/current
		try_files {path} /index.html
		file_server
	}
}

# Uptime Kuma on VPS-2 (R20), reachable only over WireGuard like the admin site: the whole site is
# bound to the hub's wg0 address and uses the same internal CA, so nothing about it is public.
#
# It gets its own site name instead of a `/kuma/` path on 10.8.0.1: Uptime Kuma 1 serves its assets
# and its websocket from the site root and has no supported sub-path mode, so a path prefix would
# load a broken UI. `10-8-0-1.sslip.io` resolves to 10.8.0.1 for the peers, and the certificate is
# Caddy's internal CA, which the peers' devices already trust for the admin site.
https://kuma.10-8-0-1.sslip.io {
	bind 10.8.0.1
	tls internal
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	header -Server
	reverse_proxy {$PEER_VCN_IP}:3001
}
