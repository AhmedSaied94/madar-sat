# VPS-2 "workers": IPv4 filter rules (SD §7.2, research R12). OWNER REVIEW REQUIRED.
#
# Rendered and applied exactly like vps1.rules (see its header). Everything is closed except SSH
# from VPS-1's VCN IP; reach this host by jumping through VPS-1 over WireGuard.
#
# Placeholders, filled from /srv/madar/.env:
#   ${PEER_VCN_IP}  VPS-1's VCN private IP
# Marker lines, replaced by bootstrap-vps.sh:
#   @PUBLIC_SSH@             public 22/tcp, kept until the OCI serial console is confirmed tested (FR-023)
#   @OCI_INSTANCE_SERVICES@  OCI's InstanceServices rules, copied unchanged from the original rules.v4
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:DOCKER-USER - [0:0]
:InstanceServices - [0:0]

# Replies, ping, loopback. (OCI's "--sport 123 ACCEPT" is dropped: NTP replies are ESTABLISHED.)
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -p icmp -j ACCEPT
-A INPUT -i lo -j ACCEPT

# SSH only from VPS-1.
-A INPUT -s ${PEER_VCN_IP}/32 -p tcp -m tcp --dport 22 -j ACCEPT
# @PUBLIC_SSH@

# OCI's default REJECT stays last.
-A INPUT -j REJECT --reject-with icmp-host-prohibited
-A FORWARD -j REJECT --reject-with icmp-host-prohibited

# Ports published on 127.0.0.1 (Flower): never from outside the host.
-A DOCKER-USER -m conntrack --ctorigdst 127.0.0.0/8 --ctdir ORIGINAL -j DROP
-A DOCKER-USER -j RETURN

# @OCI_INSTANCE_SERVICES@
COMMIT
