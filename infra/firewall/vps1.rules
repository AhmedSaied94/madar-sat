# VPS-1 "app": IPv4 filter rules (SD §7.2, research R12). OWNER REVIEW REQUIRED.
#
# infra/scripts/bootstrap-vps.sh renders this file into /etc/iptables/rules.v4 and applies it with
# iptables-restore; netfilter-persistent restores it at boot. Never run `netfilter-persistent
# save`: it would persist Docker's own chains too. check-firewall.sh compares the two.
#
# Placeholders, filled from /srv/madar/.env:
#   ${VCN_IP}       this host's VCN private IP
#   ${PEER_VCN_IP}  VPS-2's VCN private IP
# Marker lines, replaced by bootstrap-vps.sh:
#   @PUBLIC_SSH@             public 22/tcp, kept until the OCI serial console is confirmed tested
#                            and a WireGuard peer has connected (FR-023)
#   @OCI_INSTANCE_SERVICES@  OCI's InstanceServices rules (metadata, iSCSI, NTP), copied unchanged
#                            from the image's original rules.v4
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:DOCKER-USER - [0:0]
:InstanceServices - [0:0]

# Replies, ping, loopback. (OCI's "--sport 123 ACCEPT" is dropped: NTP replies are ESTABLISHED.)
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -p icmp -j ACCEPT
-A INPUT -i lo -j ACCEPT

# Public: ACME and HTTPS (Caddy), the WireGuard hub.
-A INPUT -p tcp -m tcp --dport 80 -j ACCEPT
-A INPUT -p tcp -m tcp --dport 443 -j ACCEPT
-A INPUT -p udp -m udp --dport 51820 -j ACCEPT

# SSH only over WireGuard.
-A INPUT -i wg0 -p tcp -m tcp --dport 22 -j ACCEPT
# @PUBLIC_SSH@

# PostgreSQL and Redis from VPS-2; Redis also over wg0 for the home scrape box (later).
-A INPUT -s ${PEER_VCN_IP}/32 -p tcp -m tcp --dport 5432 -j ACCEPT
-A INPUT -s ${PEER_VCN_IP}/32 -p tcp -m tcp --dport 6379 -j ACCEPT
-A INPUT -i wg0 -p tcp -m tcp --dport 6379 -j ACCEPT

# OCI's default REJECT stays last; every ACCEPT above comes before it.
-A INPUT -j REJECT --reject-with icmp-host-prohibited
-A FORWARD -j REJECT --reject-with icmp-host-prohibited

# Docker-published ports are DNATed and never reach INPUT, so their limits live here (Docker
# jumps to DOCKER-USER first in FORWARD). Each rule matches the original destination, before DNAT.
# PostgreSQL and Redis on the VCN IP: only from VPS-2.
-A DOCKER-USER ! -s ${PEER_VCN_IP}/32 -p tcp -m conntrack --ctorigdst ${VCN_IP} --ctorigdstport 5432 --ctdir ORIGINAL -j DROP
-A DOCKER-USER ! -s ${PEER_VCN_IP}/32 -p tcp -m conntrack --ctorigdst ${VCN_IP} --ctorigdstport 6379 --ctdir ORIGINAL -j DROP
# api-admin on 10.8.0.1:8001: only from wg0.
-A DOCKER-USER ! -i wg0 -p tcp -m conntrack --ctorigdst 10.8.0.1 --ctorigdstport 8001 --ctdir ORIGINAL -j DROP
# Ports published on 127.0.0.1 (api-public): never from outside the host.
-A DOCKER-USER -m conntrack --ctorigdst 127.0.0.0/8 --ctdir ORIGINAL -j DROP
-A DOCKER-USER -j RETURN

# @OCI_INSTANCE_SERVICES@
COMMIT
