# EXAMPLE VALUES ONLY. Every value below is a fake placeholder.
# The real values live only on the hosts, in /srv/madar/.env (mode 600, owner deploy), and are
# never committed. CI validates the Compose files and the Caddyfile with this file, and
# compose/dev.yml uses its dev-only values on 127.0.0.1.
# Format: one KEY=value per line, no quotes, no trailing comments (docker --env-file reads values
# verbatim).

# Compose interpolation (vps1.yml, vps2.yml).
# MADAR_ENV_FILE points each service's env_file at this file for CI and dev. Never set it on a host.
MADAR_ENV_FILE=example.env
GHCR_OWNER=example-owner
IMAGE_TAG=0000000000000000000000000000000000000000
# The backup services' own tag (B2-R1-1): `infra.yml` pushes the run SHA and the moving `stable`,
# and `deploy.sh` pulls `stable` on both hosts. Empty means `stable`.
BACKUP_IMAGE_TAG=
VCN_IP=10.0.0.10
HEALTHZ_FORCE_FAIL=false
# D4 R1/R3: what api-public trusts as Caddy's peer (it runs on the host and reaches the API through
# the fixed bridge gateway of compose/vps1.yml) and the load-test allowlist, which must stay empty
# outside a test window (docs/runbooks/load-testing.md).
TRUSTED_PROXIES_PUBLIC=127.0.0.1,172.30.0.1
# gunicorn workers for api-public: VPS-1's core count plus one (docs/runbooks/provision-host.md).
API_PUBLIC_WORKERS=2
RATE_LIMIT_EXEMPT_IPS=

# Host and network (Caddyfile, bootstrap-vps.sh, wg-add-peer.sh).
VPS1_IP=192.0.2.10
PEER_VCN_IP=10.0.0.20
ACME_EMAIL=owner@example.com
FIREBASE_PROJECT_ID=your-firebase-project-id
DEPLOY_SSH_PUBLIC_KEY=ssh-ed25519 AAAA-example-not-a-real-key deploy@ci

# PostgreSQL and Redis containers.
POSTGRES_USER=madar
POSTGRES_PASSWORD=changeme
POSTGRES_DB=madar
REDIS_PASSWORD=changeme
# Seeds the `homebox` user of infra/redis/users.acl.tmpl (the owner's scrape box). URL-safe.
REDIS_HOMEBOX_PASSWORD=changeme-homebox
# The address `wg-add-peer.sh home-box` gave the box; the only peer allowed to reach 6379 on wg0.
HOME_BOX_WG_IP=10.8.0.4

# Backend settings (backend/app/settings.py). Inside Compose, the hosts are the service names.
DATABASE_URL=postgresql+asyncpg://madar:changeme@postgres:5432/madar
DATABASE_URL_SYNC=postgresql+psycopg://madar:changeme@postgres:5432/madar
REDIS_URL=redis://:changeme@redis:6379/0
MEDIA_BASE_URL=https://media.192.0.2.10.sslip.io
MEDIA_ROOT=/srv/media
MEDIA_REHOST_ALLOWED_HOSTS=old-media.example.com,imgs.example.com
CORS_ORIGINS=https://your-firebase-project-id.web.app,https://your-firebase-project-id.firebaseapp.com
CONTRACT_VERSION=1.0.0
# Signs the admin access JWT (backend/app/auth/, Lane B1). At least 32 bytes: `openssl rand -hex 32`.
ADMIN_JWT_SECRET=changeme-admin-jwt-secret-at-least-32-bytes

# VPS-2 workers and Flower (vps2.yml). They reach VPS-1 over the VCN.
CELERY_BROKER_URL=redis://:changeme@10.0.0.10:6379/0
FLOWER_BASIC_AUTH=admin:changeme
# Lane B2's own settings (backend/app/adapters/config.py).
# The old Sat Air project, read only by the bridge, never committed (D15, FR-052).
SATAIR_FIREBASE_PROJECT_ID=your-satair-project-id
SATAIR_FIREBASE_API_KEY=your-satair-web-api-key
# The fetcher refuses an anonymous agent.
SCRAPE_USER_AGENT=MadarSat/1.0 (+https://madar.example; owner@example.com)
# `scrape_home` (the home box, the default) or `scrape` (VPS-2).
YSSCORES_FETCH_QUEUE=scrape_home
# The same choice for LiveSoccerTV (R14). A changed value needs a restarted worker and beat.
LIVESOCCERTV_FETCH_QUEUE=scrape_home
# The countries LiveSoccerTV listings are read from, comma-separated (R16). Empty uses the built-in
# MENA list.
LIVESOCCERTV_COUNTRIES=
# Consecutive failed runs that open a source's breaker (R17).
SOURCE_BREAKER_THRESHOLD=3
# Telegram alerts (VPS-2 only). Empty means alerts are logged and not sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Where VPS-2 keeps raw pages for 5 days.
RAW_ROOT=/srv/raw
# Read-only GHCR token on the home box, for `home-box-update.sh` (10-minute systemd timer).
GHCR_READ_TOKEN=ghp_example-read-only-token

# The live poller (backend/app/live/config.py, spec 031). VPS-2's worker-live and worker-maintenance read
# these. All are optional: left out, each takes the value shown. `capture-report.md` may change the page
# cap and the timers.
# Whether Goal.com is read. false sends it no request and stores nothing new from it.
LIVE_GOAL_ENABLED=true
LIVE_PAGE_CAP_GOAL=4
# How long a lower score, an earlier status or a missing event must last.
LIVE_DROP_HOLD_S=300
# How long sources may differ before an alert.
LIVE_DISAGREE_AFTER_S=600
# How long one source must show full time alone.
LIVE_FULLTIME_HOLD_S=600
# Kickoff + this, for a match no source has closed, and how long its score must have stood.
LIVE_STUCK_AFTER_MIN=150
LIVE_STUCK_QUIET_MIN=15

# D3 notifications (VPS-2's worker-notify, SD §6.8). The service account JSON is mounted at
# /srv/secrets/fcm.json (mode 600, uncommitted); FCM_DRY_RUN sends without delivering.
FCM_CREDENTIALS_FILE=/srv/secrets/fcm.json
FCM_DRY_RUN=false
PWA_ORIGIN=https://your-firebase-project-id.web.app

# D3 Uptime Kuma push monitors (R20). One per Celery queue and per backup job; empty disables it.
KUMA_PUSH_URL_MAINTENANCE=
KUMA_PUSH_URL_IMPORTS=
KUMA_PUSH_URL_NOTIFICATIONS=
KUMA_PUSH_URL_LIVE=
# VPS-2 reports the home box's queue: down once more than SCRAPE_HOME_BACKLOG_MAX fetches wait.
KUMA_PUSH_URL_SCRAPE_HOME=
SCRAPE_HOME_BACKLOG_MAX=6
KUMA_PUSH_URL_BACKUP_DB=
KUMA_PUSH_URL_BACKUP_MEDIA=
KUMA_PUSH_URL_BACKUP_MEDIA_WEEKLY=

# D3 backups (R19). VPS-2 backs up the database to Backblaze B2 with restic; VPS-1 mirrors the media
# to the OCI bucket with rclone and keeps a weekly restic copy.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
BACKUP_STAGING=/srv/backup
RCLONE_CONFIG_OCI_TYPE=s3
RCLONE_CONFIG_OCI_PROVIDER=Other
RCLONE_CONFIG_OCI_ACCESS_KEY_ID=
RCLONE_CONFIG_OCI_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OCI_ENDPOINT=
RCLONE_CONFIG_OCI_REGION=
RCLONE_BUCKET=madar-media

# Local development only (dev.yml).
DEV_POSTGRES_PORT=5434
DEV_REDIS_PORT=6380
