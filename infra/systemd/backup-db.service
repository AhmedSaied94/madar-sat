# Nightly PostgreSQL backup on VPS-2 (R19, SC-004). Started by backup-db.timer at 03:00 Africa/Cairo.
# Installed by scripts/deploy.sh; the script and the Compose file come from /srv/madar/infra.
#
# A systemd timer, not a Celery beat entry: a backup must survive a broken broker or a dead worker,
# which is exactly the incident it is there for (R19).
[Unit]
Description=Madar Sat: nightly PostgreSQL backup to Backblaze B2
Documentation=file:/srv/madar/infra/../docs/runbooks/backups.md
Wants=network-online.target docker.service
After=network-online.target docker.service
# A `Type=oneshot` unit never starts twice at once, and restic's repository lock is the second guard.

[Service]
Type=oneshot
# Through /bin/bash: the container mounts the script, and systemd-analyze verify then checks a path
# that exists on every host.
ExecStart=/usr/bin/docker compose --env-file /srv/madar/.env -f /srv/madar/infra/compose/vps2.yml run --rm -T backup-db
WorkingDirectory=/srv/madar/infra
User=root
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=45min
