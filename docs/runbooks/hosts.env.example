# The real values behind the runbooks' placeholders (`<VPS1_IP>`, `api.<VPS1_IP>.sslip.io`, ...).
# Copy to hosts.env (git-ignored) and fill in; the runbooks never carry the values themselves.
# Load it in a shell with `set -a; . docs/runbooks/hosts.env; set +a`.
VPS1_IP=             # VPS-1's reserved public IP; the public hosts are api./media./app.<VPS1_IP>.sslip.io
VPS2_IP=             # VPS-2's reserved public IP (public SSH only until it closes)
KUMA_HOST=           # Uptime Kuma's admin host, served by VPS-1's Caddy over WireGuard
PWA_HOST=            # The PWA's live Firebase Hosting host
PWA_PREVIEW_HOST=    # The `master` preview channel's host
FIREBASE_AUTH_DOMAIN=
