            "content": {
              "application/json": {
                "examples": {
                  "login_ok": {
                    "value": {
                      "data": {
                        "access_token": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIzIn0.signature",
                        "admin": {
                          "email": "editor@example.com",
