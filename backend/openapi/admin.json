  "info": {
    "description": "Admin API \u2014 reachable only over WireGuard (constitution V).",
    "title": "Madar Sat Admin API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/api/auth/login": {
      "post": {
        "operationId": "login_admin_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "login_ok": {
                    "value": {
                      "data": {
                        "access_token": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIzIn0.signature",
                        "admin": {
                          "email": "editor@example.com",
                          "id": 3,
                          "name": "\u0645\u062d\u0631\u0631",
                          "role": "editor"
                        },
                        "expires_in": 900,
                        "token_type": "Bearer"
                      },
                      "error": null,
                      "meta": {
                        "generated_at": "2026-10-29T13:00:00Z"
                      },
                      "success": true
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Envelope_Session_"
                }
              }
            },
            "description": "Login success; sets both cookies",
            "headers": {
              "Set-Cookie": {
                "description": "madar_refresh=<opaque>; HttpOnly; Secure; SameSite=Strict; Path=/admin/api/auth; Max-Age=1209600 and madar_csrf=<value>; Secure; SameSite=Strict; Path=/; Max-Age=1209600 (readable by JS)",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "examples": {
                  "invalid_credentials": {
                    "value": {
                      "data": null,
                      "error": {
                        "code": "invalid_credentials",
                        "message": "invalid credentials"
                      },
                      "meta": {
                        "attempts_remaining": 3
                      },
                      "success": false
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid credentials"
          },
          "422": {
            "content": {
              "application/json": {
                "examples": {
                  "validation_error": {
                    "value": {
                      "data": null,
                      "error": {
                        "code": "validation_error",
                        "message": "invalid request"
                      },
                      "meta": {
                        "errors": [
                          {
                            "loc": [
                              "body",
                              "email"
                            ],
                            "type": "value_error"
                          }
                        ]
                      },
                      "success": false
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation error"
          },
          "429": {
            "content": {
              "application/json": {
                "examples": {
                  "account_locked": {
                    "value": {
                      "data": null,
                      "error": {
                        "code": "account_locked",
                        "message": "account locked"
                      },
                      "meta": {
                        "retry_after_s": 872
                      },
                      "success": false
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Temporarily locked"
          }
        },
        "summary": "Log in (501 on D1)",
        "tags": [
          "auth"
        ]
      }
    },
    "/admin/api/auth/logout": {
      "post": {
        "operationId": "logout_admin_api_auth_logout_post",
        "parameters": [
          {
            "description": "Must equal the madar_csrf cookie",
            "in": "header",
            "name": "X-CSRF-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Must equal the madar_csrf cookie",
              "title": "X-Csrf-Token"
            }
          },
          {
            "description": "Opaque refresh token (HttpOnly)",
            "in": "cookie",
            "name": "madar_refresh",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque refresh token (HttpOnly)",
              "title": "Madar Refresh"
            }
          },
          {
            "description": "CSRF value; echo it in X-CSRF-Token",
            "in": "cookie",
            "name": "madar_csrf",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "CSRF value; echo it in X-CSRF-Token",
              "title": "Madar Csrf"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Logged out; the refresh token is revoked",
            "headers": {
              "Set-Cookie": {
                "description": "Clears madar_refresh and madar_csrf (Max-Age=0)",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "examples": {
                  "csrf_failed": {
                    "value": {
                      "data": null,
                      "error": {
                        "code": "csrf_failed",
                        "message": "csrf failed"
                      },
                      "meta": {},
                      "success": false
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "CSRF header missing or mismatched"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Log out (501 on D1)",
        "tags": [
          "auth"
        ]
      }
    },
